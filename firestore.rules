rules_version = '2';

// ============================================
// SUBLIMAROC - Règles Firestore
//
// Principe : le catalogue est public en lecture (pages / et /products),
// tout le reste — et toute écriture — exige un compte authentifié.
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Catalogue affiché sur le site public
    match /Produits/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /SousProduits/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Libellés des caractéristiques : lus pour afficher les fiches produit
    match /Settings/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Données de gestion : back-office uniquement
    match /Articles/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /Achats/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /AchatsArticles/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /Consommables/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /Ventes/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /AutresDepenses/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Profils : chacun ne lit que le sien. Les rôles se modifient
    // depuis la console Firebase, jamais depuis le client.
    match /users/{userId} {
      // Lecture ouverte aux comptes connectés : la page Achats affiche la
      // photo de profil de chaque acheteur. Un profil ne contient que nom,
      // rôle et photo — aucune donnée secrète.
      allow read: if isSignedIn();

      // Chacun peut poser sa propre photo de profil, et rien d'autre :
      // le rôle reste hors de portée du client, comme auparavant.
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['photoURL']);
      allow update: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['photoURL']);
      allow delete: if false;
    }

    // Tout le reste est refusé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
